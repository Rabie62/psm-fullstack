{
  "info": {
    "name": "PSM - Projects Manager API (Spring Boot 3.2.2 + JWT)",
    "description": "Collection Postman officielle pour tester les endpoints CRUD, Login/Register JWT et RBAC (Admin vs Collaborateur)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth - Register Collaborateur (Envoi Email Admin)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "http://127.0.0.1:8081/api/auth/register", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8081", "path": ["api", "auth", "register"]},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Ibn Ltaief\",\n  \"prenom\": \"Rabie\",\n  \"email\": \"rabie@ensi-uma.tn\",\n  \"tel\": \"+216 55 000 000\",\n  \"password\": \"password123\",\n  \"roles\": [\"COLLABORATEUR\"]\n}"
        }
      }
    },
    {
      "name": "2. Auth - Login Admin (Récupération Token JWT)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "http://127.0.0.1:8081/api/auth/login", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8081", "path": ["api", "auth", "login"]},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smartsoft.tn\",\n  \"password\": \"admin123\"\n}"
        }
      }
    },
    {
      "name": "3. Clients - Ajouter un Client (ADMIN ou COLLABORATEUR)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ],
        "url": {"raw": "http://127.0.0.1:8081/clients/add", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8081", "path": ["clients", "add"]},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Orange Tunisie\",\n  \"tel\": \"+216 31 111 111\",\n  \"email\": \"contact@orange.tn\",\n  \"adresse\": \"Centre Urbain Nord, Tunis\",\n  \"activite\": \"Télécommunications\"\n}"
        }
      }
    },
    {
      "name": "4. Clients - Lister tous les Clients",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
        "url": {"raw": "http://127.0.0.1:8081/clients/list", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8081", "path": ["clients", "list"]}
      }
    },
    {
      "name": "5. Projets - Créer un Projet pour le Client #1",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
        ],
        "url": {"raw": "http://127.0.0.1:8081/projets/add/1", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8081", "path": ["projets", "add", "1"]},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"libelle\": \"Refonte Portail Client IA\",\n  \"budget\": 45000.0,\n  \"duree\": \"6 mois\",\n  \"description\": \"Développement FullStack Spring Boot & Angular\"\n}"
        }
      }
    },
    {
      "name": "6. Projets - Supprimer un Projet (ADMIN uniquement)",
      "request": {
        "method": "DELETE",
        "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
        "url": {"raw": "http://127.0.0.1:8081/projets/delete/1", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8081", "path": ["projets", "delete", "1"]}
      }
    }
  ]
}
